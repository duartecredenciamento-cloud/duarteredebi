# Produção: use o DATABASE_URL do PostgreSQL gerenciado.
DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/bi_rede_duarte
SESSION_SECRET=gere-uma-chave-aleatoria-longa-e-privada
COOKIE_SECURE=1
SESSION_HOURS=8
ENVIRONMENT=production
ADMIN_BOOTSTRAP_CPF=CPF_VALIDO_DO_ADMIN
ADMIN_BOOTSTRAP_PASSWORD=senha-temporaria-com-12-caracteres-ou-mais
ADMIN_BOOTSTRAP_NAME=Administrador Master
# Dados persistentes fora do código da aplicação:
DATA_DIR=/data/bi-rede-duarte
